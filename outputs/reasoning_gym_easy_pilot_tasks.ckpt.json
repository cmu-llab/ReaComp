      "name": "decrypt_caesar",
      "code": "def decrypt_caesar(cipher_text: str, shift: int) -> str:\n    \"\"\"Decrypt a Caesar cipher by shifting letters backward by *shift* positions.\n    Non\u2011alphabetic characters are left unchanged. The function works for both\n    uppercase and lowercase English letters.\n    \"\"\"\n    result = []\n    for ch in cipher_text:\n        if 'A' <= ch <= 'Z':\n            # Compute shifted char within A-Z\n            offset = (ord(ch) - ord('A') - shift) % 26\n            result.append(chr(ord('A') + offset))\n        elif 'a' <= ch <= 'z':\n            offset = (ord(ch) - ord('a') - shift) % 26\n            result.append(chr(ord('a') + offset))\n        else:\n            result.append(ch)\n    return ''.join(result)",
      "description": "Decrypt a Caesar cipher with a given shift.",
      "domain": "string_manipulation",
      "input_types": [
        "str",
        "int"
      ],
      "output_type": "str",
      "usage_count": 30,
      "creation_cost": 1.85,
      "usefulness": 16.2162
    },
