    {
      "name": "evaluate_arithmetic_expression",
      "code": "def evaluate_arithmetic_expression(question: str) -> str:\n    \"\"\"Extract and evaluate a simple arithmetic expression from a question string.\n    The question is expected to contain the phrase 'Calculate <expression>.' where <expression>\n    uses integers and the operators +, -, *, /, and parentheses. Returns the result as a string.\n    \"\"\"\n    import re\n    # Find the expression after 'Calculate' and before the period.\n    match = re.search(r\"Calculate\\s+(.+?)\\.\", question)\n    if not match:\n        raise ValueError(\"No arithmetic expression found in the question.\")\n    expr = match.group(1).strip()\n    # Allow only safe characters.\n    allowed_chars = set(\"0123456789+-*/() \")\n    if not set(expr) <= allowed_chars:\n        raise ValueError(\"Expression contains unsafe characters.\")\n    # Evaluate safely without builtins.\n    result = eval(expr, {\"__builtins__\": None}, {})\n    # Convert to int if the result is an integer value.\n    if isinstance(result, float) and result.is_integer():\n        result = int(result)\n    return str(result)",
      "description": "Evaluate arithmetic expression from a question string and return result as string.",
      "domain": "arithmetic_evaluation",
      "input_types": [
        "str"
      ],
      "output_type": "str",
