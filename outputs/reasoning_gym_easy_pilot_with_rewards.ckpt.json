      "name": "evaluate_arithmetic_expression",
      "code": "def evaluate_arithmetic_expression(question: str) -> str:\n    \"\"\"Parse a simple arithmetic question like \"Calculate -5 * -6.\" and return the integer result as a string.\"\"\"\n    # Remove leading phrase and trailing punctuation\n    prefix = \"Calculate\"\n    if question.startswith(prefix):\n        expr = question[len(prefix):].strip()\n    else:\n        expr = question.strip()\n    # Remove trailing period if present\n    if expr.endswith('.'):\n        expr = expr[:-1]\n    # Evaluate safely: allow only digits, whitespace, parentheses and basic operators\n    allowed_chars = set(\"0123456789+-*/()% \")\n    if not set(expr).issubset(allowed_chars):\n        raise ValueError(\"Expression contains unsupported characters\")\n    # Use eval with empty globals/locals for safety\n    result = eval(expr, {\"__builtins__\": None}, {})\n    return str(int(result))\n",
      "description": "Parse a simple arithmetic question and return the integer result as a string.",
      "domain": "math",
      "input_types": [
