      "name": "caesar_decrypt",
      "code": "def caesar_decrypt(cipher: str) -> str:\n    \"\"\"Decrypt a Caesar\u2011ciphered string by trying all shifts and selecting the most English\u2011like result.\n    The function tests each possible shift (0\u201125) and chooses the decoded text that contains the most\n    common English words (e.g., 'THE', 'AND', 'TO', 'OF'). It returns that best candidate.\n    \"\"\"\n    alphabet = \"ABCDEFGHIJKLMNOPQRSTUVWXYZ\"\n    words_common = {\"THE\", \"AND\", \"TO\", \"OF\", \"IN\", \"IS\", \"IT\", \"FOR\", \"ON\", \"WITH\"}\n    # Prepare uppercase version for decoding\n    cipher_up = cipher.upper()\n    best_score = -1\n    best_plain = \"\"\n    for shift in range(26):\n        decoded_chars = []\n        for ch in cipher_up:\n            if ch in alphabet:\n                idx = (alphabet.index(ch) - shift) % 26\n                decoded_chars.append(alphabet[idx])\n            else:\n                decoded_chars.append(ch)\n        decoded = \"\".join(decoded_chars)\n        # Score by counting common words\n        score = sum(1 for w in words_common if f\" {w} \" in f\" {decoded} \")\n        if score > best_score:\n            best_score = score\n            best_plain = decoded\n    return best_plain\n",
      "description": "Decrypt a Caesar cipher by brute\u2011forcing all shifts and picking the most plausible English text.",
      "domain": "string_manipulation",
      "input_types": [
        "str"
      ],
      "output_type": "str",
      "usage_count": 46,
      "creation_cost": 2.3,
      "usefulness": 20.0
    },
    {
      "name": "caesar_decrypt_with_shift",
      "code": "def caesar_decrypt_with_shift(cipher: str, shift: int) -> str:\n    \"\"\"Decrypt a Caesar\u2011ciphered string using the provided shift.\n\n    Args:\n        cipher: The encrypted text (any case, non\u2011letters are preserved).\n        shift: Number of positions each letter was shifted forward during encryption.\n               The function shifts letters backward by this amount.\n    Returns:\n        The decrypted plaintext in the same case as the input.\n    \"\"\"\n    alphabet_upper = \"ABCDEFGHIJKLMNOPQRSTUVWXYZ\"\n    alphabet_lower = alphabet_upper.lower()\n    result_chars = []\n    for ch in cipher:\n        if ch.isupper():\n            idx = alphabet_upper.index(ch)\n            plain_idx = (idx - shift) % 26\n            result_chars.append(alphabet_upper[plain_idx])\n        elif ch.islower():\n            idx = alphabet_lower.index(ch)\n            plain_idx = (idx - shift) % 26\n            result_chars.append(alphabet_lower[plain_idx])\n        else:\n            result_chars.append(ch)\n    return \"\".join(result_chars)",
      "description": "Decrypt a Caesar cipher using a specified shift.",
      "domain": "string_manipulation",
      "input_types": [
        "str",
        "int"
      ],
      "output_type": "str",
      "usage_count": 22,
      "creation_cost": 2.25,
      "usefulness": 9.7778
    },
