      "code": "def generate_replace_program_sequence(inputs: list[str], outputs: list[str]) -> str:\n    \"\"\"Generate a markdown Python code block containing ordered ``replace`` programs to transform *inputs* into *outputs*.\n    The function uses ``infer_replace_sequence`` to infer the list of ``replace(A, B)`` statements and then formats them as a\n    markdown code block suitable for the task description.\n    \"\"\"\n    programs = infer_replace_sequence(inputs, outputs)\n    inner = \", \".join(f'\"{p}\"' for p in programs)\n    return f\"```python\\n[{inner}]\\n```\"\n",
