      "name": "infer_replace_sequence",
      "code": "def infer_replace_sequence(inputs: list[str], outputs: list[str]) -> list[str]:\n    \"\"\"Infer an ordered list of simple ``replace(A, B)`` programs (as strings) that transform *inputs* into *outputs*.\n    The function looks for character\u2011to\u2011substring mappings that are consistent across the corpus and returns\n    statements like ``replace(\"z\", \"xwy\")``. It assumes each replacement replaces a single character (len(A)=1)\n    with a string of length \u2264\u202f3, as required by the task constraints.\n    \"\"\"\n    # Collect candidate mappings from each input\u2011output pair\n    candidate: dict[str, str] = {}\n    for inp, out in zip(inputs, outputs):\n        i, j = 0, 0\n        while i < len(inp) and j < len(out):\n            if inp[i] == out[j]:\n                i += 1\n                j += 1\n                continue\n            # mismatch: record mapping from inp[i] to a slice of out starting at j\n            # we limit the replacement length to at most 3 characters as per spec\n            repl = out[j:j+3]\n            cand_char = inp[i]\n            # store only if consistent with any previous observation\n            if cand_char in candidate:\n                if candidate[cand_char] != repl:\n                    # conflicting mapping \u2013 ignore this pair\n                    break\n            else:\n                candidate[cand_char] = repl\n            i += 1\n            j += len(repl)\n        # If one string still has remaining characters, treat them as deletions (replace with \"\")\n        if i < len(inp) and j == len(out):\n            for k in range(i, len(inp)):\n                cand_char = inp[k]\n                if cand_char in candidate and candidate[cand_char] != \"\":\n                    break\n                candidate[cand_char] = \"\"\n        if j < len(out) and i == len(inp):\n            # extra output characters cannot be produced by a simple replace of a single input char;\n            # ignore for this lightweight inference.\n            pass\n    # Build the program list preserving the order of discovery (sorted by key for determinism)\n    programs: list[str] = []\n    for src in sorted(candidate.keys()):\n        dst = candidate[src]\n        programs.append(f\"replace('{src}', '{dst}')\")\n    return programs",
